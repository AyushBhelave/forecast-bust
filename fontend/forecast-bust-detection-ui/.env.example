# FastAPI backend base URL. Only used when NEXT_PUBLIC_USE_MOCK_DATA=false.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# When "true" (default), the app uses local deterministic fixtures from
# lib/mock-data.ts instead of calling the backend. Set to "false" once a
# real FastAPI backend implementing the routes in lib/api.ts is running.
NEXT_PUBLIC_USE_MOCK_DATA=true
